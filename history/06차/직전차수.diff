+def model_label(value):
+    if value is None:
+        return '미배정'
+    return f"{value.get('model', '확인 불가')} / {value.get('effort', '확인 불가')}"
+
+
+def model_card_label(value):
+    if value is None:
+        return '미배정'
+    return f"{value.get('model', '확인 불가')} · 추론 {value.get('effort', '확인 불가')}"
