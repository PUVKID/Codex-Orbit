+    ('Na','나트륨','#aec8dd','#dcecff'), ('Mg','마그네슘','#a6c7dc','#dcecff'),
+    ('Al','알루미늄','#a5b9cf','#dcecff'), ('Si','규소','#afaee0','#dcecff'),
+    ('P','인','#a9c2db','#dcecff'), ('S','황','#b0ccdf','#dcecff'),
+    ('Cl','염소','#accdda','#dcecff'), ('Ar','아르곤','#b6b8df','#dcecff'),
