+            raise ValueError('빈 지침 또는 2 MiB 초과 지침은 적용할 수 없습니다.')
+        if BEGIN in added or END in added:
+            raise ValueError('지침 내용에 앱 관리구역 표식을 넣을 수 없습니다.')
+        existed = target.exists()
+        original = target.read_bytes() if existed else b''
