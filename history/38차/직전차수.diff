+        self.stage_kind = None
+        self.phase = 'check'
+        self.updater = SafeUpdater(controller.settings.directory)
+        self.recent_result = read_update_result(controller.settings.directory)
+        self.resize(580, 340)
+        layout = QVBoxLayout(self)
+        self.label = QLabel()
