+    for index,axis in enumerate(((.6,1,.3),(-.9,.3,1))):
+        matrix=np.eye(4); matrix[:3,:3]=rotation(axis,(.40,-.44)[index]*math.sin(phase+index))@rotation((0,0,1),(.2,1.2)[index])@rotation((1,0,0),(.8,-.7)[index])
