+            payload = message.get('params')
+            if isinstance(payload, dict) and isinstance(payload.get('rateLimitsByLimitId'), dict):
+                self._accept(payload)
+            elif isinstance(payload, dict) and isinstance(payload.get('rateLimits'), dict):
