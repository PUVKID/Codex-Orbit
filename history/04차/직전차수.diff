+        if not self.pending or isinstance(message.get('id'), bool) or message.get('id') != self.pending[0]:
+            return
+        _, request = self.pending
+        self.pending = None
+        self.deadline.stop()
+        if request == 'account/rateLimits/read' and self.pending_epoch != self.account_epoch:
