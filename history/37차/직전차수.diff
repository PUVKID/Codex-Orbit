+                inset = 1.5 + step
+                area = QRectF(self.rect()).adjusted(inset, inset, -inset, -inset)
+                radius = max(1, 9 - inset)
+                painter.drawRoundedRect(area, radius, radius)
+        finally:
+            painter.end()
