+                    t=k*math.tau/(n if count==1 else 6)
+                    orb((x+w*math.cos(t),0,w*math.sin(t)),(2,3,2),silver)
+        elif recipe=='triangle':rod([(-w,-h*.5,0),(0,h,0),(w,-h*.5,0),(-w*.7,-h*.5,0)],2,silver)
