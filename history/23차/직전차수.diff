+def joining_particle(name):
+    """마지막 한글 음절의 받침에 맞춰 대상 이름을 연결합니다."""
+    last=ord(name[-1])
+    return '과' if 0xAC00 <= last <= 0xD7A3 and (last-0xAC00)%28 else '와'
+
