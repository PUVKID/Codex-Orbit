+    elif kind=='balloon':
+        # 기낭 패널과 줄·바구니가 연결된 열기구 한 대입니다.
+        ball((0,13,0),(25,31,23),(.75,.23,.045))
+        for j in range(8):
+            angle=j*math.tau/8
+            points=[(25*math.sin(t)*math.cos(angle),13+31*math.cos(t),23*math.sin(t)*math.sin(angle)) for t in np.linspace(.12,math.pi-.25,40)]
