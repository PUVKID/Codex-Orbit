+        block((65,8,30),(0,-30,0),(.65,.79,.86))
+        for x,height in ((-23,32),(0,49),(23,35)):
+            add(lathe([(0,-26),(9,-26),(9,height-22),(0,height-10)],6),pos=(x,0,0),tint=ice,rough=.18)
