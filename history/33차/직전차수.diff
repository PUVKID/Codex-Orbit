+
+def _cached_country(cc):
+    if _cache_directory is None: return None
+    pointer = _cache_directory/'active'/(cc+'.json')
+    if not pointer.is_file(): return None
+    try:
+        _, value = _read(pointer, 4096)
+        generation = value.get('generation')
