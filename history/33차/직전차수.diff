+def weather_number_text(value):
+    """표시만 소수 둘째 자리 아래를 버리고 저장된 관측값은 바꾸지 않습니다."""
+    from decimal import Decimal, ROUND_DOWN, localcontext
+    if type(value) not in (int, float) or not math.isfinite(value):
+        return '—'
+    with localcontext() as context:
+        context.prec = 330
+        text = format(Decimal(str(value)).quantize(Decimal('0.01'), rounding=ROUND_DOWN), 'f')
+    return text.rstrip('0').rstrip('.') if '.' in text else text
+
+
+def percentage_text(value):
+    """원값은 유지하고 백분율 요약만 소수 첫째 자리에서 명시적으로 반올림합니다."""
+    from decimal import Decimal,ROUND_HALF_UP
+    if type(value) not in (int,float) or not math.isfinite(value) or not 0<=value<=100:return '—'
+    rounded=Decimal(str(value)).quantize(Decimal('0.1'),rounding=ROUND_HALF_UP)
+    text=format(rounded,'.1f')+'%'
+    return t('약 {value}',value=text) if (rounded==100 and value<100) or (rounded==0 and value>0) else text
+
+
+def percentage_tooltip(value):
+    if type(value) not in (int,float) or not math.isfinite(value):return t('미확인')
+    return t('백분율은 소수 첫째 자리 반올림 · 원값: ')+repr(value)+'% · '+t('원비율: ')+repr(value/100)
+
+
+def remaining_text(value):
+    return t('{percent} 남음',percent=percentage_text(value)) if value is not None else t('잔량 미확인')
+
