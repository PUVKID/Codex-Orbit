+    points = np.asarray(points, dtype=float)
+    vertices = []
+    indices = []
+    count = len(points)
+    for i, p in enumerate(points):
+        before = points[(i - 1) % count] if closed or i else points[0]
+        after = points[(i + 1) % count] if closed or i < count - 1 else points[-1]
