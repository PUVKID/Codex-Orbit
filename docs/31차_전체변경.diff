+COMPOSITIONS = {
+ ('꽃','꽃'):('꽃의 화원','bouquet'), ('꽃','열매'):('꽃과 열매의 정물','diagonal'),
+ ('꽃','잎'):('잎이 감싼 화원','shelter'), ('꽃','악기'):('꽃의 실내악','stage'),
