+    indices = []
+    for axis in range(3):
+        other = [i for i in range(3) if i != axis]
+        for sign in (-1, 1):
+            start = len(vertices)
+            for i in range(steps + 1):
+                for j in range(steps + 1):
+                    p = np.zeros(3)
+                    p[axis] = sign * half[axis]
+                    p[other] = [(2 * i / steps - 1) * half[other[0]], (2 * j / steps - 1) * half[other[1]]]
