+            except OSError as error:
+                if getattr(error, 'winerror', None) not in (5, 32, 33) or attempt == len(delays):
+                    raise
+                time.sleep(delays[attempt])
+    except Exception as error:
+        failure = error
+        raise
+    finally:
+        try:
+            temp.unlink(missing_ok=True)
+        except OSError as cleanup_error:
+            if failure is None:
+                raise
