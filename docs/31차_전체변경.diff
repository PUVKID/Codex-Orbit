+    @staticmethod
+    def setting_label(value):
+        if value is None:
+            return t('이전 기록 없음')
+        effort = value.get('effort')
+        labels = {'none': t('없음'), 'minimal': t('최소'), 'low': t('낮음'), 'medium': t('보통'),
+                  'high': t('높음'), 'xhigh': t('매우 높음'), 'ultra': t('최고')}
