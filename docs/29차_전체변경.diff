+        self.assertEqual(self.store.snapshot()['agents'][0]['status'], 'waiting')
+        self.assertEqual(len(self.store.snapshot()['events']), 2)
+
+    def test_replay_boundary_uses_selected_record_despite_delivery_delay_or_equal_time(self):
