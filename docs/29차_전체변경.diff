+++ b/history/29차/src/core.py
@@ -0,0 +1,229 @@
+"""외부 통신 없는 로컬 자료 읽기와 명시적 지침 적용."""
+from datetime import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import uuid
+
+MAX_TEXT_BYTES = 2 * 1024 * 1024
+BEGIN = b'<!-- CODEX-ORBIT:BEGIN -->'
+END = b'<!-- CODEX-ORBIT:END -->'
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def read_jsonl_tail(path, max_bytes=MAX_TEXT_BYTES, max_records=500):
+    """물리적 LF만 나누며 잘린 앞/뒤 조각은 레코드로 해석하지 않습니다."""
+    path = Path(path)
+    if not path.exists():
+        return [], []
+    with path.open('rb') as handle:
+        size = handle.seek(0, os.SEEK_END)
+        start = max(0, size - max_bytes)
+        handle.seek(start)
+        raw = handle.read(max_bytes)
+    problems = []
+    if start:
+        problems.append(f'앞부분 생략: 전체 {size}바이트, 최대 {max_bytes}바이트 읽음')
+        raw = raw.partition(b'\n')[2]
+    pieces = raw.split(b'\n')
+    pieces.pop()  # 마지막 LF 뒤 조각 또는 미완성 레코드는 기다립니다.
+    rows = []
+    for number, piece in enumerate(pieces):
+        if not piece:
+            continue
+        try:
+            row = json.loads(piece.decode('utf-8'))
+            if not isinstance(row, dict):
+                raise ValueError('JSON 객체가 아닙니다.')
+            rows.append(row)
+        except (UnicodeError, ValueError) as error:
+            problems.append(f'읽은 범위의 레코드 {number + 1}: {error}')
+    return rows[-max_records:], problems[:50]
+
+
+def session_titles(path):
+    rows, _ = read_jsonl_tail(path, max_records=10000)
+    return {r['id']: r['thread_name'][:500] for r in rows
+            if isinstance(r.get('id'), str) and isinstance(r.get('thread_name'), str)
+            and r['thread_name'].strip()}
+
+
+def title_catalog(index_path, cache_path):
+    """공식 앱에서 확인해 저장한 제목과 로컬 색인의 출처를 보존합니다."""
+    rows, _ = read_jsonl_tail(index_path, max_records=10000)
+    result = {r['id']: {'title': r['thread_name'], 'source': '로컬 session_index.jsonl',
+                       'checked_at': r.get('updated_at', '확인 시각 미기록')}
+              for r in rows if isinstance(r.get('id'), str) and isinstance(r.get('thread_name'), str)
+              and r['thread_name'].strip() and len(r['thread_name']) <= 2000}
+    if Path(cache_path).exists():
+        cache = json.loads(read_text_strict(cache_path))
+        if not isinstance(cache, dict) or not isinstance(cache.get('titles'), dict):
+            raise ValueError('제목 캐시 구조가 올바르지 않습니다.')
+        for sid, title in cache['titles'].items():
+            if isinstance(sid, str) and isinstance(title, str) and title.strip() and len(title) <= 2000:
+                checked_at = cache.get('checked_at') or cache.get('observed_at') or '확인 시각 미기록'
+                # 두 출처 모두 시각이 확인될 때만 최신 제목을 우선합니다.
+                def confirmed_time(value):
+                    try:
+                        parsed = datetime.fromisoformat(str(value).replace('Z', '+00:00'))
+                        return parsed if parsed.tzinfo is not None else None
+                    except ValueError:
+                        return None
+                cached_time = confirmed_time(checked_at)
+                indexed_time = confirmed_time(result.get(sid, {}).get('checked_at'))
+                if cached_time is not None and indexed_time is not None and indexed_time > cached_time:
+                    continue
+                result[sid] = {'title': title, 'source': str(cache.get('source', '출처 미기록')) + ' 확인 캐시',
+                               'checked_at': checked_at}
+    return result
+
+
+def resolve_title(event, catalog):
+    """자식 작업은 실제 부모 채팅 제목과 작업명을 분리합니다."""
+    value = dict(event)
+    sid = event.get('parent') or event.get('target')
+    entry = catalog.get(sid)
+    if entry:
+        value.update(chat_name=entry['title'], title_target=sid,
+                     title_source=entry['source'], title_checked_at=entry['checked_at'])
+    elif not value.get('chat_name') or value.get('chat_name') == value.get('target'):
+        value.update(chat_name='채팅 제목 확인 불가', title_target=sid, title_source='확인 불가')
+    value['task_name'] = event.get('task_name') or str(event.get('agent_path') or '').rsplit('/', 1)[-1] or '현재 채팅'
+    return value
+
+
+def clamp_position(position, screens, size=140):
+    for x, y, width, height in screens:
+        if x <= position[0] and y <= position[1] and position[0] + size <= x + width and position[1] + size <= y + height:
+            return tuple(position)
+    if not screens:
+        return (24, 24)
+    x, y, _, _ = screens[0]
+    return (x + 24, y + 24)
+
+
+def safe_path(path):
+    """적용 파일과 모든 기존 조상 경로의 링크/재분석 지점을 거부합니다."""
+    path = Path(os.path.abspath(path))
+    for part in [path, *path.parents]:
+        try:
+            info = part.lstat()
+        except FileNotFoundError:
+            continue
+        if stat.S_ISLNK(info.st_mode) or getattr(info, 'st_file_attributes', 0) & 0x400:
+            raise ValueError('링크 또는 재분석 경로에는 적용할 수 없습니다: ' + str(part))
+    return path
+
+
+def read_text_strict(path):
+    path = Path(path)
+    if path.stat().st_size > MAX_TEXT_BYTES:
+        raise ValueError('문서가 2 MiB 상한을 초과했습니다.')
+    return path.read_bytes().decode('utf-8-sig')
+
+
+class InstructionStore:
+    def __init__(self, data_dir):
+        self.data_dir = Path(data_dir)
+
+    def _target(self, target):
+        target = safe_path(target)
+        if target.name.lower() != 'agents.md':
+            raise ValueError('적용 대상은 AGENTS.md 파일이어야 합니다.')
+        if not target.parent.is_dir():
+            raise ValueError('대상 폴더가 존재하지 않습니다.')
+        if target.exists() and (not target.is_file() or target.stat().st_size > MAX_TEXT_BYTES):
+            raise ValueError('대상은 2 MiB 이하의 일반 파일이어야 합니다.')
+        return target
+
+    def preview(self, target, content):
+        target = self._target(target)
+        added = content.encode('utf-8')
+        if not content.strip() or len(added) > MAX_TEXT_BYTES:
+            raise ValueError('빈 지침 또는 2 MiB 초과 지침은 적용할 수 없습니다.')
+        if BEGIN in added or END in added:
+            raise ValueError('지침 내용에 앱 관리구역 표식을 넣을 수 없습니다.')
+        existed = target.exists()
+        original = target.read_bytes() if existed else b''
+        original.decode('utf-8-sig')
+        block = BEGIN + b'\n' + added.rstrip(b'\r\n') + b'\n' + END
+        if BEGIN in original or END in original:
+            if original.count(BEGIN) != 1 or original.count(END) != 1 or original.index(BEGIN) >= original.index(END):
+                raise ValueError('기존 관리구역 표식이 손상되었거나 중복되었습니다.')
+            start = original.index(BEGIN)
+            finish = original.index(END) + len(END)
+            result = original[:start] + block + original[finish:]
+        else:
+            result = original + (b'\n' if original and not original.endswith(b'\n') else b'') + block + b'\n'
+        if len(result) > MAX_TEXT_BYTES:
+            raise ValueError('적용 결과가 2 MiB 상한을 초과합니다.')
+        return {'target': str(target), 'before_hash': digest(original), 'existed': existed,
+                'original': original, 'applied_bytes': result, 'after_hash': digest(result)}
+
+    def _unchanged(self, target, existed, expected):
+        target = self._target(target)
+        if target.exists() != existed or digest(target.read_bytes() if existed else b'') != expected:
+            raise ValueError('대상 파일이 미리보기/적용 이후 변경되었습니다. 새 미리보기가 필요합니다.')
+        return target
+
+    def _replace(self, target, raw, existed, expected):
+        temp = target.parent / ('.codex-orbit-' + uuid.uuid4().hex + '.tmp')
+        try:
+            with temp.open('xb') as handle:
+                handle.write(raw)
+                handle.flush()
+                os.fsync(handle.fileno())
+            self._unchanged(target, existed, expected)
+            if existed:
+                os.chmod(temp, stat.S_IMODE(target.stat().st_mode))
+            os.replace(temp, target)
+        finally:
+            temp.unlink(missing_ok=True)
+
+    def apply(self, plan):
+        target = self._unchanged(plan['target'], plan['existed'], plan['before_hash'])
+        if digest(plan['original']) != plan['before_hash'] or digest(plan['applied_bytes']) != plan['after_hash']:
+            raise ValueError('미리보기 데이터가 변경되었습니다.')
+        backup_dir = safe_path(self.data_dir / 'backups')
+        backup_dir.mkdir(parents=True, exist_ok=True)
+        backup = backup_dir / (uuid.uuid4().hex + '.bin')
+        with backup.open('xb') as handle:
+            handle.write(plan['original'])
+            handle.flush()
+            os.fsync(handle.fileno())
+        receipt = {key: value for key, value in plan.items() if key != 'original'}
+        receipt['backup'] = str(backup)
+        # 쓰기 실패 시에도 원문 백업은 남기며 적용 성공이라고 기록하지 않습니다.
+        self._replace(target, plan['applied_bytes'], plan['existed'], plan['before_hash'])
+        manifest = {key: value for key, value in receipt.items() if key != 'applied_bytes'}
+        (backup.with_suffix('.json')).write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding='utf-8')
+        return receipt
+
+    def restore(self, receipt):
+        target = self._unchanged(receipt['target'], True, receipt['after_hash'])
+        backup = safe_path(receipt['backup'])
+        if backup.parent != safe_path(self.data_dir / 'backups') or not backup.is_file() or backup.stat().st_size > MAX_TEXT_BYTES:
+            raise ValueError('유효한 앱 원문 백업이 아닙니다.')
+        raw = backup.read_bytes()
+        if digest(raw) != receipt['before_hash']:
+            raise ValueError('백업 해시가 일치하지 않습니다.')
+        if receipt['existed']:
+            self._replace(target, raw, True, receipt['after_hash'])
+        else:
+            self._unchanged(target, True, receipt['after_hash'])
+            target.unlink()
+
+    def receipts(self):
+        directory = self.data_dir / 'backups'
+        if not directory.is_dir():
+            return []
+        result = []
+        for path in sorted(directory.glob('*.json'), key=lambda p: p.stat().st_mtime, reverse=True)[:100]:
+            if path.stat().st_size <= 10000:
+                result.append(json.loads(path.read_text(encoding='utf-8')))
+        return result
diff --git a/history/29차/src/element_frames.py b/history/29차/src/element_frames.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e9bbb767b27c11d68b36f54115478101e9e4e1f
--- /dev/null
+++ b/history/29차/src/element_frames.py
@@ -0,0 +1,146 @@
+"""오늘 원소 하나의 압축 프레임만 여는 제한 메모리 재생기입니다."""
+from collections import OrderedDict
+import atexit
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import struct
+import sys
+import zipfile
+from PySide6.QtGui import QImage
+from elements import ELEMENTS,daily_element
+
+CACHE_LIMIT=24
+FRAME_SIZE=192
+FRAME_COUNT=540
+FPS=30
+PERIOD_SECONDS=18
+MAX_ARCHIVE_BYTES=64*1024*1024
+MAX_FRAME_BYTES=512*1024
+
+
+class ElementAssetError(RuntimeError):
+    """필수 원소 자산 실패를 숨기지 않고 앱의 시작·표시 오류로 전달합니다."""
+
+
+def asset_directory():
+    return Path(getattr(sys,'_MEIPASS',Path(__file__).resolve().parents[1]))/'assets/elements3d'
+
+
+def _number(element):
+    number=element if type(element) is int else getattr(element,'number',None)
+    if type(number) is not int or not 1<=number<=31:
+        raise ElementAssetError('원소 번호는1~31 정수여야 합니다.')
+    return number
+
+
+def _identity(path):
+    value=path.stat()
+    return value.st_dev,value.st_ino,value.st_size,value.st_mtime_ns
+
+
+def _object(pairs):
+    result={}
+    for key,value in pairs:
+        if key in result:raise ElementAssetError('원소 매니페스트 중복 필드: '+key)
+        result[key]=value
+    return result
+
+
+class ElementFrames:
+    def __init__(self,number,directory=None):
+        self.number=_number(number);self.cache=OrderedDict();self.archive=None;self.stream=None
+        root=asset_directory() if directory is None else Path(directory)
+        self.directory=root/f'{self.number:02d}_{ELEMENTS[self.number-1].symbol}'
+        try:self._prepare()
+        except Exception as error:
+            self.close()
+            if isinstance(error,ElementAssetError):raise
+            raise ElementAssetError('필수 원소 자산 읽기 실패: '+str(error)) from error
+
+    def _prepare(self):
+        manifest=self.directory/'manifest.json';archive=self.directory/'frames.zip'
+        if not 0<manifest.stat().st_size<=64*1024:raise ElementAssetError('원소 매니페스트 크기 오류')
+        self.manifest=json.loads(manifest.read_text(encoding='utf-8'),object_pairs_hook=_object)
+        expected={'schema_version':1,'number':self.number,'symbol':ELEMENTS[self.number-1].symbol,'width':192,'height':192,
+                  'fps':30,'period_seconds':18,'frame_count':540,'frame_pattern':'frame_{:04d}.png','archive':'frames.zip'}
+        if not isinstance(self.manifest,dict):raise ElementAssetError('원소 매니페스트는 객체여야 합니다.')
+        for key,value in expected.items():
+            actual=self.manifest.get(key)
+            if type(actual) is not type(value) or actual!=value:raise ElementAssetError('원소 계약 불일치: '+key)
+        digest=self.manifest.get('archive_sha256')
+        if not isinstance(digest,str) or not re.fullmatch('[0-9a-f]{64}',digest):raise ElementAssetError('원소 해시 형식 오류')
+        if not 0<archive.stat().st_size<=MAX_ARCHIVE_BYTES:raise ElementAssetError('원소 압축파일 크기 초과')
+        self.identities=(_identity(manifest),_identity(archive));self.stream=archive.open('rb');hasher=hashlib.sha256()
+        while block:=self.stream.read(1024*1024):hasher.update(block)
+        if hasher.hexdigest()!=digest:raise ElementAssetError('원소 ZIP 해시 불일치')
+        self.stream.seek(0);self.archive=zipfile.ZipFile(self.stream);members=self.archive.infolist()
+        if len(members)!=540 or {m.filename for m in members}!={f'frame_{i:04d}.png' for i in range(540)}:
+            raise ElementAssetError('원소 ZIP 정확한540프레임 목록 불일치')
+        if sum(m.file_size for m in members)>128*1024*1024:raise ElementAssetError('원소 해제 크기 초과')
+        for member in members:
+            if (member.is_dir() or member.flag_bits&1 or member.compress_type not in (zipfile.ZIP_STORED,zipfile.ZIP_DEFLATED)
+                    or not 0<member.file_size<=MAX_FRAME_BYTES):raise ElementAssetError('원소 ZIP 멤버 형식 오류')
+        self.cache[0]=self._decode(0);self._check_unchanged()
+
+    def _check_unchanged(self):
+        try:actual=(_identity(self.directory/'manifest.json'),_identity(self.directory/'frames.zip'))
+        except OSError as error:raise ElementAssetError('원소 자산 경로가 변경됐습니다.') from error
+        if actual!=self.identities:raise ElementAssetError('실행 중 원소 자산이 변경됐습니다.')
+
+    def _decode(self,index):
+        try:
+            with self.archive.open(f'frame_{index:04d}.png') as stream:data=stream.read(MAX_FRAME_BYTES+1)
+            if (len(data)>MAX_FRAME_BYTES or len(data)<33 or data[:8]!=b'\x89PNG\r\n\x1a\n' or data[12:16]!=b'IHDR'
+                    or struct.unpack('>II',data[16:24])!=(192,192) or data[24:26]!=bytes((8,6))):raise ElementAssetError('원소 PNG 형식 오류')
+            image=QImage.fromData(data,'PNG')
+            if image.isNull() or image.size().width()!=192 or image.height()!=192 or not image.hasAlphaChannel():raise ElementAssetError('원소 PNG 디코딩 오류')
+            if any(image.pixelColor(x,y).alpha() for x,y in ((0,0),(191,0),(0,191),(191,191))):raise ElementAssetError('원소 PNG 투명 모서리 오류')
+            return image.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
+        except ElementAssetError:raise
+        except Exception as error:raise ElementAssetError('원소 프레임 읽기 실패: '+str(error)) from error
+
+    def frame(self,elapsed):
+        if isinstance(elapsed,bool) or not isinstance(elapsed,(int,float)) or not math.isfinite(elapsed):raise ElementAssetError('원소 재생 시각은 유한한 숫자여야 합니다.')
+        if self.archive is None:raise ElementAssetError('원소 재생기가 닫혔습니다.')
+        self._check_unchanged();index=int((elapsed%18)*30)%540
+        if index not in self.cache:
+            self.cache[index]=self._decode(index)
+            while len(self.cache)>CACHE_LIMIT:self.cache.popitem(last=False)
+        self.cache.move_to_end(index);return self.cache[index]
+
+    @property
+    def cache_bytes(self):return sum(image.sizeInBytes() for image in self.cache.values())
+
+    def close(self):
+        if self.archive is not None:self.archive.close();self.archive=None
+        if self.stream is not None:self.stream.close();self.stream=None
+        self.cache.clear()
+
+
+_active=None
+
+
+def close_element_frames():
+    global _active
+    previous,_active=_active,None
+    if previous is not None:previous.close()
+
+
+def preflight_element_frames(element=None):
+    """활성 원소의 해시·목록·첫 프레임을 확인합니다.31개를 적재하지 않습니다."""
+    global _active
+    number=_number(daily_element() if element is None else element)
+    if _active is None or _active.number!=number:
+        close_element_frames();_active=ElementFrames(number)
+    else:_active._check_unchanged()
+    return _active
+
+
+def get_element_frame(element,elapsed):
+    return preflight_element_frames(element).frame(elapsed)
+
+
+atexit.register(close_element_frames)
