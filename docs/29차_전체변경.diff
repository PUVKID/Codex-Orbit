+    @Slot()
+    def deliver_next_notice(self):
+        if self.closing or not self.notice_queue:
+            return
+        ticket, event = self.notice_queue.popleft()
+        try:
+            self.receive(event)
+        finally:
+            ticket.release()
+            if self.notice_queue and not self.closing:
+                self.notice_delivery_timer.start(0)
