+        try:
+            if self.kernel.GetProcessIdOfThread(thread) != process.pid:
+                raise OSError('초기 스레드 소유 PID가 달라 재개하지 않았습니다.')
+            previous = self.kernel.ResumeThread(thread)
+            if previous == 0xFFFFFFFF:
