+    chunks, size = [], 0
+    with opener.open(request, timeout=20) as response:
+        while True:
+            chunk = response.read(min(65536, maximum - size + 1))
+            if not chunk:
+                break
+            size += len(chunk)
+            if size > maximum:
+                raise UpdateError('릴리스 응답이 허용 크기를 초과했습니다.')
