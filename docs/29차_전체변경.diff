+        for j in range(sides):
+            a = i * sides + j
+            b = (i + 1) % count * sides + j
+            c = (i + 1) % count * sides + (j + 1) % sides
+            d = i * sides + (j + 1) % sides
+            indices.extend((a, b, c, a, c, d))
+    return finish(vertices, indices)
