+        'shelter':((-29,15,-8),(29,-18,1)), 'stage':((-30,-21,-6),(30,-21,1)),
+        'triangle':((-27,-25,-3),(27,-25,2)), 'fan':((-30,9,-6),(30,9,1)),
+    }
