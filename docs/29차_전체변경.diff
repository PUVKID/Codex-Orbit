+                n = np.array([(next_y - y) * math.cos(t), radius - next_radius, (next_y - y) * math.sin(t)])
+                n /= np.linalg.norm(n)
+                vertices.append((*p, *n))
+            indices.extend((start, start + 1, start + 2, start, start + 2, start + 3))
