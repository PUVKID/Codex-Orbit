+            'OpenProcess': ((wintypes.DWORD, wintypes.BOOL, wintypes.DWORD), ctypes.c_void_p),
+            'CreateToolhelp32Snapshot': ((wintypes.DWORD, wintypes.DWORD), ctypes.c_void_p),
