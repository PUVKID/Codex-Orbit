+        from observatory_scene import observatory_positions
+        from calendar_motion import calendar_motion_status
+        positions=observatory_positions(self.scene,calendar_motion_status().get('scene_elapsed',0.))
+        nearest=min(positions,key=lambda p:(p['x']-x)**2+(p['y']-y)**2,default=None)
+        if nearest and (nearest['x']-x)**2+(nearest['y']-y)**2<.035**2:self.open_target(nearest['target'])
+        else:self.click_started=time.monotonic();self.timer.start();self.feed_scene();self.controller.show()
+    def show_bookmarks(self):
+        self.open_page(0)
+        c=self.controller
+        for i in range(c.window.history.count()):
+            item=c.window.history.item(i);item.setHidden(item.data(Qt.ItemDataRole.UserRole).get('id') not in c.features.bookmarks)
+    def show_all(self):
+        self.open_page(0)
+        for i in range(self.controller.window.history.count()):self.controller.window.history.item(i).setHidden(False)
+    def diagnostics(self):
+        from calendar_motion import calendar_motion_status
+        path,_=QFileDialog.getSaveFileName(self.controller.window,tr('진단 ZIP 저장','Save diagnostics ZIP'),'CodexOrbit-diagnostics.zip','ZIP (*.zip)')
+        if path:
+            try:self.controller.features.write_diagnostics(path,self.controller.last_monitor_status or {},calendar_motion_status())
+            except Exception as error:QMessageBox.warning(self.controller.window,tr('저장 실패','Save failed'),str(error))
+    def check_update(self):
+        from update_widgets import show_update
+        show_update(self.controller)
+    def health(self,value):
+        state=value.get('state','');healthy=state=='감시 중';problem=any(x in state for x in ('오류','중단','지연','실패'))
+        if self.last_health is None:
+            if healthy:self.last_health=True
+            elif problem:self.last_health=False
+            return
+        if (healthy or problem) and healthy!=self.last_health:
+            self.last_health=healthy
+            c=self.controller;event={'id':'health-'+str(time.time_ns()),'kind':'health','chat_name':tr('Codex 감시 상태','Codex monitor status'),'time':value.get('time'),'reason':tr('감시 연결이 복구되어 새 변경을 계속 알려드립니다.','Monitoring recovered; new changes will be reported.') if healthy else tr('변경을 확인하지 못하고 있습니다. 연결을 다시 확인하는 중입니다.','Changes cannot be observed. Retrying the connection.'),'before':None,'after':None}
+            c.enqueue_notice(event)
+    def dock(self):
+        c=self.controller;orbit=c.orbit
+        if not c.settings.values.get('edge_docking') or self.docked:return
+        screen=QApplication.screenAt(orbit.pos()) or QApplication.primaryScreen()
+        if not screen:return
+        rect=screen.availableGeometry()
+        if abs(orbit.x()-rect.left())>32 and abs(rect.right()+1-orbit.x()-orbit.width())>32:return
+        self.expanded_size=orbit.size();self.expanded_position=orbit.pos();self.docked=True
+        orbit.setMinimumSize(32,80);orbit.resize(40,120)
+        orbit.move(rect.left() if orbit.x()-rect.left()<32 else rect.right()-39,max(rect.top(),min(orbit.y(),rect.bottom()-119)))
+    def expand(self):
+        if self.docked:
+            orbit=self.controller.orbit;self.docked=False;orbit.resize(self.expanded_size);orbit.move(self.expanded_position);orbit.setMinimumSize(180,250);orbit.restore_position()
diff --git a/src/observatory_scene.py b/src/observatory_scene.py
new file mode 100644
index 0000000000000000000000000000000000000000..beb73ae917117703840a2f00ff510b9ce4b934e3
--- /dev/null
+++ b/src/observatory_scene.py
@@ -0,0 +1,144 @@
+"""관측소 스냅샷 검증과 렌더·클릭이 공유하는 실제 3D 배치입니다."""
+import math
+import re
+
+MAX_AGENTS = 24
+CAMERA = 700.0
+EXTENT = 69.0
+
+
+def _number(value, low, high, name):
+    if type(value) not in (int, float):
+        raise ValueError(name + ' 값은 유한한 숫자여야 합니다.')
+    try:
+        valid = math.isfinite(value) and low <= value <= high
+    except OverflowError:
+        valid = False
+    if not valid:
+        raise ValueError(name + ' 값이 허용 범위를 벗어났습니다.')
+    return float(value)
+
+
+def normalize_scene(scene):
+    """개인 기록을 추가 수집하지 않고 전달받은 최신 값만 독립 복사합니다."""
+    if not isinstance(scene, dict):
+        raise TypeError('관측소 장면은 dict여야 합니다.')
+    result = {}
+    for key in ('model', 'effort'):
+        value = scene.get(key)
+        if value is not None and (not isinstance(value, str) or len(value) > 128):
+            raise ValueError(key + ' 값은 짧은 원문 문자열 또는 None이어야 합니다.')
+        result[key] = value
+    quality = scene.get('quality', 'balanced')
+    if quality not in ('eco', 'balanced', 'high'):
+        raise ValueError('품질은 eco, balanced, high 중 하나여야 합니다.')
+    result['quality'] = quality
+    for key in ('paused', 'reduced_motion'):
+        value = scene.get(key, False)
+        if type(value) is not bool:
+            raise ValueError(key + ' 값은 bool이어야 합니다.')
+        result[key] = value
+    usage = scene.get('usage_fraction')
+    result['usage_fraction'] = None if usage is None else _number(usage, 0, 1, '사용 한도')
+    pointer = scene.get('pointer', (0, 0))
+    if not isinstance(pointer, (tuple, list)) or len(pointer) != 2:
+        raise ValueError('포인터는 두 정규 좌표여야 합니다.')
+    result['pointer'] = [_number(v, -1, 1, '포인터') for v in pointer]
+    result['transition'] = _number(scene.get('transition', 1), 0, 1, '전환')
+    result['press'] = _number(scene.get('press', 0), 0, 1, '눌림')
+    agents = scene.get('agents', [])
+    if not isinstance(agents, (list, tuple)) or len(agents) > MAX_AGENTS:
+        raise ValueError('GPU 작업자 위성은 최대 24개여야 합니다.')
+    result['agents'] = []
+    targets = set()
+    for agent in agents:
+        if not isinstance(agent, dict):
+            raise ValueError('작업자 항목은 dict여야 합니다.')
+        target = agent.get('target')
+        status = agent.get('status', 'unknown')
+        pinned = agent.get('pinned', False)
+        if not isinstance(target, str) or not target or len(target) > 200 or target in targets:
+            raise ValueError('작업자 target은 중복 없는 원문 ID여야 합니다.')
+        if not isinstance(status, str) or len(status) > 64 or type(pinned) is not bool:
+            raise ValueError('작업자 상태와 고정 여부를 확인할 수 없습니다.')
+        targets.add(target)
+        result['agents'].append({'target': target, 'status': status, 'pinned': pinned})
+    return result
+
+
+def model_family(model):
+    match = re.fullmatch(r'gpt-\d+(?:\.\d+)?-(sol|astra|terra|luna)', model or '')
+    return match.group(1) if match else 'unknown'
+
+
+def particle_count(effort):
+    return {'none': 0, 'minimal': 3, 'low': 6, 'medium': 12,
+            'high': 20, 'xhigh': 32, 'ultra': 48}.get(effort, 0)
+
+
+def scene_fps(scene):
+    return {'eco': 20, 'balanced': 30, 'high': 60}[scene.get('quality', 'balanced')]
+
+
+def scene_time(scene, elapsed):
+    value = _number(elapsed, -1e12, 1e12, '모션 시각')
+    return 0.0 if scene.get('reduced_motion') else value
+
+
+def world_matrix(scene):
+    """렌더와 클릭 위치에 동일한 미세 시점 이동·눌림 배율을 적용합니다."""
+    x, y = scene.get('pointer', (0, 0))
+    ax, ay = y * .09, x * .09
+    cx, sx, cy, sy = math.cos(ax), math.sin(ax), math.cos(ay), math.sin(ay)
+    scale = 1 - .08 * scene.get('press', 0)
+    return [[scale * cy, scale * sy * sx, scale * sy * cx, 0],
+            [0, scale * cx, -scale * sx, 0],
+            [-scale * sy, scale * cy * sx, scale * cy * cx, 0],
+            [0, 0, 0, 1]]
+
+
+def transform_point(scene, point):
+    matrix = world_matrix(scene)
+    return tuple(sum(matrix[i][j] * point[j] for j in range(3)) for i in range(3))
+
+
+def project_point(point):
+    """실제 카메라와 중앙 정사각 crop에 대응하는 0..1 좌표입니다."""
+    x, y, z = point
+    perspective = CAMERA / (CAMERA - z)
+    return .5 + x * perspective / (2 * EXTENT), .5 - y * perspective / (2 * EXTENT), .5 + z / 140
+
+
+def agent_world_positions(scene, elapsed):
+    scene = normalize_scene(scene)
+    elapsed = scene_time(scene, elapsed)
+    result = []
+    count = len(scene['agents'])
+    for index, agent in enumerate(scene['agents']):
+        phase = math.tau * index / max(1, count)
+        if not agent['pinned']:
+            phase += elapsed * .22
+        radius = 52 if agent['pinned'] else 57
+        status = agent['status']
+        bob = 2 * math.sin(elapsed * (4 if status in ('retrying', 'retry') else 1.3) + index)
+        shake = 1.2 * math.sin(elapsed * 10) if status == 'error' else 0
+        x = radius * math.cos(phase) + shake
+        y = radius * .66 * math.sin(phase) + bob
+        # 용기 윗부분을 가리는 중앙 하단 구역에서는 궤도를 부드럽게 들어 올립니다.
+        weight = min(1., max(0., (26 - abs(x)) / 10))
+        weight = weight * weight * (3 - 2 * weight)
+        y += max(0., -22 - y) * weight
+        result.append({**agent, 'position': (x, y,
+                                           21 * math.sin(phase + .4))})
+    return result
+
+
+def observatory_positions(scene, elapsed):
+    """같은 표시 프레임의 scene_elapsed를 받아 위성의 정확한 클릭 중심을 돌려줍니다."""
+    scene = normalize_scene(scene)
+    result = []
+    for agent in agent_world_positions(scene, elapsed):
+        x, y, depth = project_point(transform_point(scene, agent['position']))
+        result.append({'target': agent['target'], 'status': agent['status'], 'pinned': agent['pinned'],
+                       'x': x, 'y': y, 'depth': depth})
+    return result
diff --git a/src/orbit_features.py b/src/orbit_features.py
new file mode 100644
index 0000000000000000000000000000000000000000..846f00fd473d99948c9118ed5bb72950c39cb8af
--- /dev/null
+++ b/src/orbit_features.py
@@ -0,0 +1,292 @@
+"""원문 이벤트와 표시를 분리하는 관측소 기록·관심 항목·개인정보 제외 진단입니다."""
+from collections import OrderedDict
+from copy import deepcopy
+from datetime import datetime, timezone
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import tempfile
+import zipfile
+
+from activity import safe_public_text
+
+
+_EMOJI = re.compile('[\U0001f000-\U0001faff\u2600-\u27bf\u2300-\u23ff\u2b05-\u2b07\u2b1b\u2b1c\u2b50\u2b55\u00a9\u00ae\u203c\u2049\u2122\u2139\u2194-\u2199\u21a9\u21aa\u2934\u2935\u3030\u303d\u3297\u3299]')
+_KEYCAP = re.compile('[0-9#*]\ufe0f?\u20e3')
+_STATUS = {'running', 'completed', 'waiting', 'error', 'aborted'}
+_LIFECYCLE_FIELDS = {'id', 'target', 'status', 'time', 'source_time', 'role', 'parent', 'parent_id'}
+_IDENTITY = re.compile(r'[A-Za-z0-9_.-]{1,128}\Z')
+_LIFECYCLE_LIMIT = 1048576
+_EVENT_FIELDS = {'id', 'target', 'title', 'chat_title', 'chat_name', 'before', 'after', 'time',
+                 'source_time', 'reason', 'kind', 'role', 'parent', 'parent_id', 'agent_path',
+                 'task_summary', 'task_name', 'activity_action', 'activity_type', 'status',
+                 'turn_id', 'evidence', 'requested', 'source', 'short_reason', 'task_source'}
+
+
+def clean_chat_title(text):
+    """장식 이모지 시퀀스만 표시에서 제거하고 일반 숫자·문자는 유지합니다."""
+    if not isinstance(text, str):
+        return ''
+    if not (_KEYCAP.search(text) or _EMOJI.search(text)):
+        return text
+    text = _KEYCAP.sub(' ', text)
+    text = _EMOJI.sub(' ', text)
+    text = re.sub('[\u200d\ufe0e\ufe0f\U000e0020-\U000e007f]', '', text)
+    return ' '.join(text.split())
+
+
+def changed_fields(event):
+    before = event.get('before') if isinstance(event.get('before'), dict) else {}
+    after = event.get('after') if isinstance(event.get('after'), dict) else {}
+    return {key for key in ('model', 'effort') if before.get(key) != after.get(key)}
+
+
+def task_hint(event, language='ko'):
+    """명시한 공개 작업 요약만 사용하며 모델 이름이나 변경 이유로 작업을 만들지 않습니다."""
+    value = safe_public_text(event.get('task_summary') or event.get('task_name'), 240)
+    return ' '.join(value.split()) if value else ('Task not observed' if language == 'en' else '확인된 작업 정보 없음')
+
+
+def _instant(value):
+    if isinstance(value, datetime):
+        if value.tzinfo is None:
+            raise ValueError('재생 시각에는 시간대가 필요합니다.')
+        return value.timestamp()
+    if type(value) in (int, float):
+        if not math.isfinite(value):
+            raise ValueError('재생 시각은 유한해야 합니다.')
+        return float(value)
+    if isinstance(value, str):
+        return _instant(datetime.fromisoformat(value.replace('Z', '+00:00')))
+    raise ValueError('재생 시각은 시간대가 있는 시각 또는 Unix 초여야 합니다.')
+
+
+def _atomic(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    handle, name = tempfile.mkstemp(prefix='.features-', suffix='.tmp', dir=path.parent)
+    try:
+        with os.fdopen(handle, 'w', encoding='utf-8', newline='\n') as stream:
+            json.dump(data, stream, ensure_ascii=False, indent=2)
+        os.replace(name, path)
+    finally:
+        Path(name).unlink(missing_ok=True)
+
+
+def _lifecycle_row(value):
+    """복원 가능한 식별·상태·시각만 검증하며 본문 필드는 받지 않습니다."""
+    if not isinstance(value, dict) or set(value) - _LIFECYCLE_FIELDS:
+        raise ValueError('생명주기 상태의 허용 필드가 아닙니다. 원본을 초기화하지 않습니다.')
+    for key in ('id', 'target', 'parent', 'parent_id'):
+        item = value.get(key)
+        if item is None and key in ('parent', 'parent_id'):
+            continue
+        if not isinstance(item, str) or not _IDENTITY.fullmatch(item):
+            raise ValueError('생명주기 ID는 1~128자의 영문·숫자·밑줄·점·하이픈이어야 합니다.')
+    if not isinstance(value.get('status'), str) or value['status'] not in _STATUS:
+        raise ValueError('명시된 생명주기 상태가 필요합니다.')
+    for key in ('time', 'source_time'):
+        item = value.get(key)
+        if item is None and key == 'source_time':
+            continue
+        if not isinstance(item, str) or len(item) > 64:
+            raise ValueError('생명주기 시각은 64자 이하의 시간대가 있는 문자열이어야 합니다.')
+        _instant(item)
+    role = value.get('role')
+    if role is not None and (not isinstance(role, str) or not role or len(role) > 64
+                             or any(ord(char) < 32 or 127 <= ord(char) <= 159
+                                    or 0xD800 <= ord(char) <= 0xDFFF for char in role)):
+        raise ValueError('생명주기 역할은 제어문자 없는 1~64자 문자열이어야 합니다.')
+    return deepcopy(value)
+
+
+class FeatureStore:
+    """본문은 메모리에 두고 관심 ID·읽음·허용된 생명주기 상태만 개인 폴더에 저장합니다."""
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        self.path = self.directory / 'features-v1.json'
+        self.lifecycle_path = self.directory / 'lifecycle-v1.json'
+        self._state = {'schema_version': 1, 'pins': [], 'bookmarks': [], 'seen_ids': []}
+        if self.path.exists():
+            if self.path.stat().st_size > 262144:
+                raise ValueError('관심 항목 상태 파일이 상한을 초과했습니다.')
+            state = json.loads(self.path.read_text(encoding='utf-8'))
+            if (not isinstance(state, dict) or state.get('schema_version') != 1
+                    or any(not isinstance(state.get(key), list)
+                           or any(not isinstance(value, str) or len(value) > 256 for value in state[key])
+                           for key in ('pins', 'bookmarks', 'seen_ids'))):
+                raise ValueError('관심 항목 상태 오류입니다. 원본을 초기화하지 않습니다.')
+            self._state = state
+        self._events = OrderedDict()
+        self._lifecycles = OrderedDict()
+        if self.lifecycle_path.exists():
+            if self.lifecycle_path.stat().st_size > _LIFECYCLE_LIMIT:
+                raise ValueError('생명주기 상태 파일이 상한을 초과했습니다.')
+            state = json.loads(self.lifecycle_path.read_text(encoding='utf-8'))
+            if (not isinstance(state, dict) or set(state) != {'schema_version', 'events'}
+                    or type(state.get('schema_version')) is not int or state['schema_version'] != 1
+                    or not isinstance(state.get('events'), list) or len(state['events']) > 512):
+                raise ValueError('생명주기 상태 오류입니다. 원본을 초기화하지 않습니다.')
+            for item in state['events']:
+                row = _lifecycle_row(item)
+                if row['id'] in self._lifecycles:
+                    raise ValueError('생명주기 ID가 중복됩니다. 원본을 초기화하지 않습니다.')
+                self._lifecycles[row['id']] = row
+
+    @property
+    def pins(self):
+        return frozenset(self._state['pins'])
+
+    @property
+    def bookmarks(self):
+        return frozenset(self._state['bookmarks'])
+
+    def _preference(self, key, identity, enabled, limit):
+        if not isinstance(identity, str) or not identity or len(identity) > 256:
+            raise ValueError('관심 항목 ID는 1~256자 문자열이어야 합니다.')
+        if type(enabled) is not bool:
+            raise TypeError('관심 항목 설정은 bool이어야 합니다.')
+        state = deepcopy(self._state)
+        values = [value for value in state[key] if value != identity]
+        if enabled:
+            if len(values) >= limit:
+                raise ValueError('관심 항목 저장 상한을 초과했습니다.')
+            values.append(identity)
+        state[key] = values
+        _atomic(self.path, state)
+        self._state = state
+
+    def set_pin(self, target, enabled):
+        self._preference('pins', target, enabled, 64)
+
+    def set_bookmark(self, event_id, enabled):
+        self._preference('bookmarks', event_id, enabled, 256)
+
+    def ingest(self, event):
+        if not isinstance(event, dict):
+            raise TypeError('이벤트는 객체여야 합니다.')
+        # payload/content/messages 같은 대화 원문은 새 저장소에 복제하지 않습니다.
+        value = {key: deepcopy(item) for key, item in event.items() if key in _EVENT_FIELDS}
+        if not isinstance(value.get('target'), str) or not value['target']:
+            raise ValueError('이벤트 대상이 필요합니다.')
+        identity = value.get('id')
+        if not isinstance(identity, str) or not identity:
+            identity = hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode('utf-8')).hexdigest()
+            value['id'] = identity
+        previous = self._events.get(identity)
+        if previous is None:
+            previous = ({'kind': 'lifecycle', **self._lifecycles[identity]}
+                        if identity in self._lifecycles else {})
+        merged = {**previous, **value}
+        if merged.get('kind') == 'lifecycle':
+            row = _lifecycle_row({key: deepcopy(item) for key, item in merged.items()
+                                  if key in _LIFECYCLE_FIELDS})
+            if self._lifecycles.get(identity) != row:
+                lifecycles = self._lifecycles.copy()
+                lifecycles[identity] = row
+                while len(lifecycles) > 512:
+                    lifecycles.popitem(last=False)
+                state = {'schema_version': 1, 'events': list(lifecycles.values())}
+                if len(json.dumps(state, ensure_ascii=False, indent=2).encode('utf-8')) > _LIFECYCLE_LIMIT:
+                    raise ValueError('생명주기 상태 파일이 상한을 초과했습니다.')
+                _atomic(self.lifecycle_path, state)
+                self._lifecycles = lifecycles
+        self._events[identity] = merged
+        while len(self._events) > 512:
+            self._events.popitem(last=False)
+
+    def load_history(self, events):
+        # 상세 정보가 보강된 같은 ID는 교체하고 이미 관측한 생명주기는 유지합니다.
+        for event in events:
+            self.ingest(event)
+
+    @staticmethod
+    def _time(event):
+        for key in ('source_time', 'time'):
+            try:
+                return _instant(event.get(key))
+            except (ValueError, TypeError, OverflowError):
+                pass
+        return None
+
+    def snapshot(self, at=None, through=None):
+        cutoff = None if at is None else _instant(at)
+        combined = {identity: {'kind': 'lifecycle', **row} for identity, row in self._lifecycles.items()}
+        for identity, event in self._events.items():
+            combined[identity] = {**combined.get(identity, {}), **event}
+        rows = [event for event in combined.values()
+                if cutoff is None or (self._time(event) is not None and self._time(event) <= cutoff)]
+        rows.sort(key=lambda event: self._time(event) if self._time(event) is not None else float('-inf'))
+        if through is not None:
+            # 감지 지연이나 같은 시각의 기록도 선택한 이벤트 다음 상태가 섞이지 않게 합니다.
+            boundary = next((index for index, event in enumerate(rows) if event['id'] == through), None)
+            if boundary is None:
+                raise ValueError('재생할 기록 ID를 현재 저장 기록에서 찾을 수 없습니다.')
+            rows = rows[:boundary + 1]
