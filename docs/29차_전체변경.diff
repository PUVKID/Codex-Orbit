+def finish(vertices,indices):
+    """표면 법선과 삼각형 winding을 일치시킵니다."""
+    v=np.asarray(vertices,dtype='f4');ix=np.asarray(indices,dtype='u4').reshape(-1,3)
+    p=v[ix,:3];n=v[ix,3:].mean(axis=1)
