+Source: "..\배포\라이선스\*"; DestDir: "{app}\라이선스"; Flags: ignoreversion recursesubdirs
+Source: "..\배포\소스와_재빌드.zip"; DestDir: "{app}"; Flags: ignoreversion
+
+[Icons]
