+        self.close()
+        QApplication.instance().quit()
+
+    def close(self):
+        if self.cleaned:
+            return
+        self.cleaned = True
+        self.closing = True
+        self.close_notice_delivery()
+        self.monitor_restart_pending = False
+        self.monitor_enabled = False
