+def session_titles(path):
+    rows, _ = read_jsonl_tail(path, max_records=10000)
+    return {r['id']: r['thread_name'][:500] for r in rows
+            if isinstance(r.get('id'), str) and isinstance(r.get('thread_name'), str)
+            and r['thread_name'].strip()}
+
