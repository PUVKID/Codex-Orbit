+def read_text_strict(path):
+    path = Path(path)
+    if path.stat().st_size > MAX_TEXT_BYTES:
+        raise ValueError('문서가 2 MiB 상한을 초과했습니다.')
+    return path.read_bytes().decode('utf-8-sig')
