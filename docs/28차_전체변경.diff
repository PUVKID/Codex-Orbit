+            vertices.append((*[radius * v for v in n], *n))
+    for i in range(latitude):
+        for j in range(longitude):
+            a = i * (longitude + 1) + j
+            b = a + longitude + 1
+            indices.extend((a, a + 1, b, a + 1, b + 1, b))
+    return (np.asarray(vertices, dtype='f4'), np.asarray(indices, dtype='u4'))
