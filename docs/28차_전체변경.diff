+def sphere_mesh(radius, longitude=96, latitude=48):
+    vertices = []
+    indices = []
+    for i in range(latitude + 1):
+        phi = math.pi * i / latitude
+        for j in range(longitude + 1):
+            theta = math.tau * j / longitude
