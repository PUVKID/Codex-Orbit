++            for index, sentence in enumerate(sentences[:-1]):
++                if re.search(r'(?:배정합니다|배정하겠습니다|맡기겠습니다)[.!]?$', sentence.replace('**', '').strip()):
++                    candidate = sentences[index + 1].strip()
++                    if re.search(r'(?:대조|검사|확인|검토|검증|구현|수정)', candidate):
++                        purpose = candidate
++                        break
