+    def _replace(self, target, raw, existed, expected):
+        temp = target.parent / ('.codex-orbit-' + uuid.uuid4().hex + '.tmp')
+        try:
+            with temp.open('xb') as handle:
+                handle.write(raw)
+                handle.flush()
