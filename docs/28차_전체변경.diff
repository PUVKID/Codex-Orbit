++        if not purpose and len(sentences) > 1 and len(text) < 70 and re.search(r'(?:맡기겠습니다|배정하겠습니다)[.!]?$', text):
++            text = sentences[1]
++    text = text.replace('**', '')
++    return text if len(text) <= limit else text[:limit - 1] + '…'
