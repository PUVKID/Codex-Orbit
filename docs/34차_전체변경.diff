++    for row in curated['occurrences']:
++        verified=[]
++        for ref in row['city_refs']:
++            options=[value for value in cities.get(ref['wikidata_qid'],[]) if value['wikidata_qid']==ref['wikidata_qid'] and value['country_code']==row['country_code']]
