--- /dev/null
+++ b/history/34차/src/orbit_entry.py
@@ -0,0 +1,21 @@
+"""단일 EXE에서 일반 GUI와 내부 GPU 자식 진입을 먼저 분기합니다."""
+import sys
+
+
+def main(arguments=None):
+    arguments = sys.argv[1:] if arguments is None else arguments
+    # 손상된 내부 요청도 일반 앱으로 떨어져 두 번째 GUI를 만들지 않습니다.
+    if any(str(value).startswith('--orbit-gpu-child') for value in arguments):
+        if not arguments or arguments[0] != '--orbit-gpu-child': return 64
+        try:
+            from calendar_gpu_child import main as child_main
+            return child_main(arguments[1:])
+        except Exception as error:
+            if sys.stderr is not None: print('GPU 내부 시작 실패: ' + str(error), file=sys.stderr)
+            return 64
+    from app import main as app_main
+    return app_main()
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/history/34차/src/percentage_display.py b/history/34차/src/percentage_display.py
new file mode 100644
index 0000000000000000000000000000000000000000..71481394f557a27f0b57b87dfd50b41c8afd1107
--- /dev/null
+++ b/history/34차/src/percentage_display.py
@@ -0,0 +1,20 @@
+"""관측 원값과 분리한 백분율 표시만 공통으로 처리합니다."""
+import math
+from decimal import Decimal, ROUND_HALF_UP
+from i18n import translate as t
+
+
+def percentage_text(value):
+    """저장값은 바꾸지 않고 백분율 요약만 소수 첫째 자리로 반올림합니다."""
+    if type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 100:
+        return '—'
+    rounded = Decimal(str(value)).quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)
+    text = format(rounded, '.1f') + '%'
+    return t('약 {value}', value=text) if (rounded == 100 and value < 100) or (rounded == 0 and value > 0) else text
+
+
+def percentage_tooltip(value):
+    """반올림 요약과 원래 백분율·비율을 구분해 안내합니다."""
+    if type(value) not in (int, float) or not math.isfinite(value):
+        return t('미확인')
+    return t('백분율은 소수 첫째 자리 반올림 · 원값: ') + repr(value) + '% · ' + t('원비율: ') + repr(value / 100)
