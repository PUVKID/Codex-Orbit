+    @Slot(object, dict)
+    def queue_delivery(self, ticket, event):
+        if self.closing:
+            ticket.release()
+            return
+        self.notice_queue.append((ticket, event))
+        if not self.notice_delivery_timer.isActive():
+            self.notice_delivery_timer.start(0)
