++                image.fill(QColor({'film':2,'music':1}[events[0]['kind']],0,0,255))
++            else:image.fill(QColor(30+int(elapsed),60,90,127))
++            return image
++        def close(self):
++            if mode=='close':native_hang()
++    try:return serve(channel,int(parent_pid),Renderer)
++    finally:channel.close()
