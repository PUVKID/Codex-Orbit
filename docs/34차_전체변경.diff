+                    if delay>=self.remaining(): raise TimeoutError('429 대기가 수집 단계의 고정 종료시각을 넘습니다.') from exc
+                    print(json.dumps(dict(status='rate_limited',retry_after_seconds=delay)),flush=True)
+                    time.sleep(delay)
