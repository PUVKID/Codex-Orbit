+_COUNTRIES = {'US': '미국', 'JP': '일본', 'CN': '중국', 'GB': '영국', 'DE': '독일',
+              'FR': '프랑스', 'CA': '캐나다', 'AU': '호주', 'SG': '싱가포르', 'TW': '대만'}
