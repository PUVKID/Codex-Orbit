+        require(self.k.QueryInformationJobObject(self.job, 1, ctypes.byref(info), ctypes.sizeof(info), None), 'GPU Job 실제 잔존 조회 실패')
+        self.last_active = info.ActiveProcesses; self.total_processes = info.TotalProcesses
