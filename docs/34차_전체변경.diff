+    def _publish(self, **changes):
+        if self.closed:
+            return
+        self.snapshot = {**self.snapshot, **changes}
+        self.changed.emit(dict(self.snapshot))
+
+    def start(self):
+        if self.closed or self.poll_timer.isActive():
+            return
