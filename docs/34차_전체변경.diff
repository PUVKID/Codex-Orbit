+def validated_motion_speed(value):
+    """설정과 UI의 속도는 유한한 실제 숫자 범위로 제한합니다."""
+    if type(value) not in (int, float) or not .25 <= value <= 3.0 or not math.isfinite(value):
+        raise ValueError(t('회전 속도는 0.25~3배의 유한한 숫자여야 합니다.'))
+    return float(value)
