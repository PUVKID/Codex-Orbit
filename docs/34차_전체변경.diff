+"""날짜별 단일 대상과 기존 회전 유틸·별도 추정 위치 행을 검증합니다."""
+import os
+import sys
+import tempfile
+import unittest
+from datetime import date
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
